# PlantManager Print Agent v2 Configuration

# Server URL - your PlantManager backend address
SERVER_URL=https://pm.polflor.wroclaw.pl

# Agent name - will be shown in the web panel
AGENT_NAME=Komputer biurowy

# Poll interval in milliseconds (how often to check for new jobs)
POLL_INTERVAL=5000

# Heartbeat interval in milliseconds (how often to report status)
HEARTBEAT_INTERVAL=30000

# Temporary directory for print files (optional)
# TEMP_DIR=C:\Temp\print-agent
