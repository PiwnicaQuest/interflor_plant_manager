export const API = new ApiClient();
export const api = API;
  // ============================================
  // PRODUCT MERGING
  // ============================================
  // PRODUCT MERGING
  // ============================================

  async getSimilarProducts(): Promise<{ groups: Array<{ products: Product[]; matchCriteria: { plantName: string; potSize: string; heightRange: { min: number; max: number } } }> }> {
    const response = await this.client.get("/inventory/similar-products");
    return response.data;
  }

  async getSimilarToProduct(productId: number): Promise<{ products: Product[]; matchCriteria: { plantName: string; potSize: string; heightRange: { min: number; max: number } } }> {
    const response = await this.client.get("/inventory/" + productId + "/similar");
    return response.data;
  }

  async getMergedProducts(masterId: number): Promise<{ masterProduct: Product; mergedProducts: Product[] }> {
    const response = await this.client.get("/inventory/" + masterId + "/merged");
    return response.data;
  }

  async mergeProducts(masterId: number, productIds: number[]): Promise<{ message: string; masterProduct: Product; mergedProductIds: number[] }> {
    const response = await this.client.post("/inventory/merge", { masterId, productIds });
    return response.data;
  }

  async unmergeProduct(productId: number): Promise<{ message: string; unmergedProduct: Product; masterProduct: Product }> {
    const response = await this.client.post("/inventory/" + productId + "/unmerge");
    return response.data;
  }

  async scanBarcodeWithMerged(barcode: string): Promise<{ product: Product; recentMovements: InventoryMovement[]; wasMergedLookup?: boolean; originalBarcode?: string }> {
    const response = await this.client.post("/inventory/scan-barcode", { barcode });
    return response.data;
  }
}

